#!/bin/sh
set -e
G=/sys/kernel/config/usb_gadget/tk1
[ -d $G ] && exit 0
mkdir -p $G && cd $G
echo 0x1d6b > idVendor
echo 0x0104 > idProduct
echo 0x0100 > bcdDevice
echo 0x0200 > bcdUSB
echo 0xEF > bDeviceClass
echo 0x02 > bDeviceSubClass
echo 0x01 > bDeviceProtocol
mkdir -p strings/0x409
cut -c1-16 /etc/machine-id > strings/0x409/serialnumber
echo NVIDIA > strings/0x409/manufacturer
echo "Jetson TK1" > strings/0x409/product
mkdir -p configs/c.1/strings/0x409
echo "NCM + ACM" > configs/c.1/strings/0x409/configuration
echo 250 > configs/c.1/MaxPower
mkdir -p functions/ncm.usb0 functions/acm.GS0
echo 02:4e:54:4b:31:01 > functions/ncm.usb0/dev_addr
echo 02:4e:54:4b:31:02 > functions/ncm.usb0/host_addr
ln -s functions/ncm.usb0 configs/c.1/
ln -s functions/acm.GS0 configs/c.1/
ls /sys/class/udc | head -n1 > UDC
